rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // CHANGE THIS to the admin's email (same as adminEmail in config.js)
    function isAdmin() { return request.auth != null && request.auth.token.email == 'admin@example.com'; }
    function claimed(k) {
      return request.auth != null
        && exists(/databases/$(database)/documents/claims/$(k))
        && get(/databases/$(database)/documents/claims/$(k)).data.uid == request.auth.uid;
    }

    match /students/{k} {
      allow read: if isAdmin() || claimed(k);
      allow create: if isAdmin() || (claimed(k) && request.resource.data.sessions.size() == 0);
      allow update, delete: if isAdmin();
    }
    match /backups/{path=**} {
      allow read, write: if isAdmin();
    }
    match /claims/{k} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && (!exists(/databases/$(database)/documents/students/$(k))
            || get(/databases/$(database)/documents/students/$(k)).data.yk == request.resource.data.yk);
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
  }
}
